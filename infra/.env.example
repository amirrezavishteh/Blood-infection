# Copy to infra/.env and edit. infra/.env is git-ignored; never commit real secrets.
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Bearer token required by every /v1 request (the dashboard asks for it once). Leave empty only on localhost.
SEPSIS_API_TOKEN=change-me-too
# Host port the API binds to on 127.0.0.1
API_PORT=8000
# Uncomment to serve the synthetic demo workspace instead of the real data:
# SEPSIS_DATA_DIR=/app/data/demo/data
# SEPSIS_ARTIFACT_DIR=/app/data/demo/artifacts
